
{{!--
  Legacy Handlebars template for CUP↔CIG.
  Conversion is now done by LD/scripts/convert_cupcig_jsonld.py (reshape + @context).
  Kept as reference for the previous approach.
--}}
{
    "@context": {
        "pi": "https://w3id.org/italia/PublicInvestment/onto/PublicInvestment/",
        "PCTR": "https://w3id.org/italia/onto/PublicContract/"
    },
    "@graph": [
        {{#each .cupcig}}
        {
        "@type": "PCTR:Lot",
        "@id": "https://w3id.org/italia/data/Lot/{{encodeURIComponent CIG}}",
        "PCTR:hasProject": {
            "@id": "{{cupUri CUP}}",
            "@type": "pi:Progetto_di_investimento_pubblico"
            }
        }
        {{#unless @last}},{{/unless}}
        {{/each}}
    ]
}
