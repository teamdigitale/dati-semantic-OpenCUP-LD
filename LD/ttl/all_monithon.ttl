    PRJ:projectTotalCost 7496725.00 ;
    l0:name "Progetto Wi-Life Station"@it .

<https://opencoesione.gov.it/it/dati/progetti/4mtra122212/> a ns1:Progetto_di_coesione,
        PRJ:PublicInvestmentProject ;
    dcterms:description "Realizzazione di un sistema ITS che consenta alla centrale operativa della Polizia Municipale di Taranto di monitorare lo stato di sottosistemi di campo, quali: rete di videosorveglianza e lettori targa, postazioni di monitoraggio di flussi veicolari, stato dei parcheggi, aree ZTL, stato dei sottopassi in particolare dello stato eventuale di allagamento, rete semaforica con possibilità di regolazione remota dei paini semaforici e implementazione di piani semaforici intelligenti, info-mobilità con segnalazione dello stato della rete viaria tramite pannelli a messaggi variabili, pannelli intelligenti e App specifiche integrate con le piattaforme Apple CarPlay e Google CarPlay."@it ;
    dcterms:identifier "4MTRA122212" ;
    dcterms:subject cup:E51B19000810001 ;
    dcterms:title "SmartTaranto 4.0"@it ;
    schema:about cup:E51B19000810001 ;
    schema:url <https://opencoesione.gov.it/it/dati/progetti/4mtra122212/> ;
    ns1:codice_locale_progetto "4MTRA122212" ;
    ns1:costo_coesione 2828305.40 ;
    ns1:ha_ciclo_programmazione <https://w3id.org/italia/draft/OpenCoesione/controlled-vocabulary/ciclo-programmazione/2> ;
    ns1:ha_cup cup:E51B19000810001 ;
    ns1:ha_fase_corrente <https://w3id.org/italia/draft/OpenCoesione/controlled-vocabulary/fase-corrente/as03> ;
    ns1:ha_macroarea <https://w3id.org/italia/draft/OpenCoesione/controlled-vocabulary/macroarea/mezzogiorno> ;
    ns1:ha_stato_finanziario <https://w3id.org/italia/draft/OpenCoesione/controlled-vocabulary/stato-finanziario/liquidato> ;
    ns1:ha_stato_procedurale <https://w3id.org/italia/draft/OpenCoesione/controlled-vocabulary/stato-procedurale/eseguito> ;
    ns1:ha_stato_progetto <https://w3id.org/italia/draft/OpenCoesione/controlled-vocabulary/stato-progetto/concluso> ;
