    ns1:url_pagina "https://opencoesione.gov.it/it/dati/progetti/5mtra1e6059/"^^xsd:anyURI ;
    PRJ:projectTitle "INTERCONNESSIONE VALLIVA: CICLOVIA TURISTICA DEL TENNA"@it ;
