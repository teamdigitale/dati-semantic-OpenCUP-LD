    ns1:ha_stato_finanziario <https://w3id.org/italia/draft/OpenCoesione/controlled-vocabulary/stato-finanziario/non-avviato> ;
    ns1:ha_stato_procedurale <https://w3id.org/italia/draft/OpenCoesione/controlled-vocabulary/stato-procedurale/in-esecuzione> ;
    ns1:ha_stato_progetto <https://w3id.org/italia/draft/OpenCoesione/controlled-vocabulary/stato-progetto/in-corso> ;
