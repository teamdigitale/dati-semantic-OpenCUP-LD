    ns1:ha_tema_sintetico <https://w3id.org/italia/draft/OpenCoesione/controlled-vocabulary/tema-sintetico/09> ;
    ns1:ha_tipologia_aiuto <https://w3id.org/italia/draft/OpenCoesione/controlled-vocabulary/tipologia-aiuto/f> ;
    ns1:sintesi "L'intervento prevede il monitoraggio delle facciate eseguito mediante ponteggi e scalatori-restauratori per verificare dello stato di conservazione e il degrado dei paramenti murari e decorativi delle facciate interne ed esterne a Palazzo Ducale. Seguira la redazione del progetto di intervento, nel quale si prevederanno interventi diffusi e puntuali di pulitura, consolidamento, restauro dei paramenti murari, degli elementi decorativi, disgregati e danneggiati. L'intervento intende conservare il paramento murario e decorativo del palazzo eseguendo appositi monitoraggi, indagini, etc che permettano di intervenire nel momento e di programmare gli interventi futuri."@it ;
    ns1:url_pagina "https://opencoesione.gov.it/it/dati/progetti/1mise14251/"^^xsd:anyURI ;
    PRJ:projectTitle "3.2.1 Cultura e Turismo - Riqualificazione funzionale di Palazzo Ducale: interventi di ripristino delle facciate interne ed esterne e delle rive d'acqua"@it ;
    PRJ:projectTotalCost 2800000.00 ;
    l0:name "3.2.1 Cultura e Turismo - Riqualificazione funzionale di Palazzo Ducale: interventi di ripristino delle facciate interne ed esterne e delle rive d'acqua"@it .

