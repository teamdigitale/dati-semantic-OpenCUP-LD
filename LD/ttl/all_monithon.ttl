    ns1:ha_macroarea <https://w3id.org/italia/draft/OpenCoesione/controlled-vocabulary/macroarea/mezzogiorno> ;
    ns1:ha_stato_finanziario <https://w3id.org/italia/draft/OpenCoesione/controlled-vocabulary/stato-finanziario/in-corso> ;
    ns1:ha_stato_procedurale <https://w3id.org/italia/draft/OpenCoesione/controlled-vocabulary/stato-procedurale/in-esecuzione> ;
